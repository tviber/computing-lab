# Copy to /etc/computing-lab/deploy.env and adjust host paths as needed.
DEPLOY_ROOT=/srv/computing-lab
SOURCE_KIND=codeload
SOURCE_REPO=tviber/computing-lab
SOURCE_REF=main
ARCHIVE_BASE_URLS="https://codeload.github.com"
GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN_FILE=/etc/computing-lab/github.token
VITE_BASE_PATH=/
KEEP_RELEASES=3
BUN_BIN=/usr/local/bin/bun
