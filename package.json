{
  "name": "computing-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "engines": {
    "node": ">=22.13",
    "bun": "1.2.17"
  },
  "scripts": {
    "setup": "bun install",
    "postinstall": "node scripts/sync-pyodide.mjs",
    "dev": "bun run vite",
    "dev:server": "node server/index.ts",
    "server": "node server/index.ts",
    "db:seed": "node server/db/seed.ts",
    "build": "bun run typecheck && bun run vite build",
    "test": "bun run vitest",
    "test:run": "bun run vitest run",
    "test:deploy": "bash deploy/tests/reconcile.test.sh",
    "test:e2e": "bun run build && playwright test",
    "deploy": "bash deploy/reconcile.sh reconcile",
    "test:caddy": "bash deploy/tests/caddy.test.sh",
    "deploy:rollback": "bash deploy/reconcile.sh rollback",
    "deploy:status": "bash deploy/reconcile.sh status",
    "lint": "bun run eslint .",
    "typecheck": "bun run typecheck:app && bun run typecheck:server && bun run tsc -p tsconfig.node.json --noEmit",
    "typecheck:server": "bun run tsc -p tsconfig.server.json --noEmit",
    "typecheck:app": "bun run tsc -p tsconfig.app.json --noEmit",
    "format:check": "bun run prettier --check .",
    "format": "bun run prettier --write ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.12",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-router": "^1.170.18",
    "@uiw/react-codemirror": "4.25.11",
    "hono": "^4.13.8",
    "pyodide": "314.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
