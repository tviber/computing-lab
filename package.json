{
  "name": "computing-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": "1.2.17"
  },
  "scripts": {
    "setup": "bun install --frozen-lockfile",
    "postinstall": "node scripts/sync-pyodide.mjs",
    "dev": "bun run vite",
    "dev:classroom": "bun run vite --mode classroom",
    "dev:server": "node server/index.ts",
    "server": "node server/index.ts",
    "db:seed": "node server/db/seed.ts",
    "sync:embed": "node scripts/sync-embed-runtime.mjs",
    "build": "bun run vite build",
    "build:classroom": "bun run vite build --mode classroom",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node dist-server/index.js",
    "test": "bun run vitest",
    "test:run": "bun run vitest run",
    "test:deploy": "bash deploy/tests/bundle.test.sh && bash deploy/tests/reconcile.test.sh && bash deploy/tests/release-contract.test.sh",
    "test:e2e": "bun run build:classroom && playwright test",
    "test:e2e:showcase": "bun run build && playwright test --config playwright.showcase.config.ts",
    "test:caddy": "bash deploy/tests/caddy.test.sh",
    "deploy:status": "bash deploy/reconcile.sh status",
    "check:css": "node scripts/check-css-duplicates.mjs",
    "lint": "bun run check:css && bun run eslint .",
    "typecheck": "bun run typecheck:app && bun run typecheck:server && bun run tsc -p tsconfig.node.json --noEmit",
    "typecheck:server": "bun run tsc -p tsconfig.server.json --noEmit",
    "typecheck:app": "bun run tsc -p tsconfig.app.json --noEmit",
    "format:check": "bun run prettier --check .",
    "format": "bun run prettier --write ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "^6.43.12",
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "4.3.1",
    "@lezer/highlight": "^1.2.3",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.4",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/solid": "0.1.0-beta.17",
    "hono": "^4.13.8",
    "katex": "^0.19.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pyodide": "314.0.5",
    "solid-js": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
